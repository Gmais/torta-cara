generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Turma {
  id           String        @id @default(uuid())
  nome         String        @unique
  pontuacao    Int           @default(0)
  alunos       Participante[]
  competicaoId String?
  competicao   Competicao?   @relation(fields: [competicaoId], references: [id])
}

model Participante {
  id      String @id @default(uuid())
  nome    String
  turmaId String
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)
}

model Pergunta {
  id            String    @id @default(uuid())
  pergunta      String
  resposta      String
  categoria     String    // e.g., "EF", "EM", "Séries e Filmes", etc.
  nomeProfessor String?   // Opcional, caso venha de um professor
  dificuldades  String[]  @default([]) // "Facil", "Moderado", "Dificil" (pode ter mais de um)
  editadoPor    String?   // Nome de quem fez a última edição
  editadoEm     DateTime?
  createdAt     DateTime  @default(now())
  destaque      Boolean   @default(false) // marca perguntas migradas de Diversos/Geral: ficam amarelas e no topo da categoria
}

// Registro de perguntas excluídas do banco, para saber quem excluiu o quê.
model PerguntaExcluida {
  id          String   @id @default(uuid())
  perguntaId  String
  pergunta    String
  resposta    String
  categoria   String
  excluidoPor String
  excluidoEm  DateTime @default(now())
}

model Configuracao {
  id              String @id @default("singleton")
  pontosPorRodada Int    @default(10)
  perguntaAtualId String?
}

model Categoria {
  id   String @id @default(uuid())
  nome String @unique
}

model Competicao {
  id     String  @id @default(uuid())
  nome   String  @unique
  turmas Turma[]
}
